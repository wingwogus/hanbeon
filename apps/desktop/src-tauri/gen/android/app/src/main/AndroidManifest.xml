<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 다른 앱 위에 컨트롤러를 올린다. 이게 없으면 Activity로만 뜨는데,
         조작할 대상 앱이 뒤로 밀려 제품이 성립하지 않는다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 오래 살아야 한다. 사용자는 스위치 말고 다른 조작 수단이 없어서
         시스템이 조용히 죽이면 되살릴 방법이 없다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 스위치는 USB 시리얼로 붙는다(PRD 7절). HID 키보드가 아니라서
         키 이벤트로는 오지 않는다. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.hanbeon"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- 4칸 컨트롤러를 다른 앱 위에 띄우는 포그라운드 서비스. -->
        <service
            android:name="kr.devfive.hanbeon.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="single-switch-accessibility-controller" />
        </service>

        <!-- 포커스 이동·선택·되돌리기(출력 전용). 스위치 입력은 오지 않는다. -->
        <service
            android:name="kr.devfive.hanbeon.HanbeonAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- 코어 연결 전 동작 검증용 통로 (참고 구현과 동일). -->
        <receiver
            android:name="kr.devfive.hanbeon.DebugActionReceiver"
            android:exported="true" />
    </application>
</manifest>
