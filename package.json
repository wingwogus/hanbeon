{
  "name": "hanbeon",
  "version": "0.1.0",
  "description": "한번 - 상황적응형 싱글스위치 접근성 소프트웨어",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "eslint-plugin-devup": "^2.1.0",
    "oxlint": "1.79",
    "husky": "^9.1",
    "bun-test-env-dom": "^1.0",
    "@devup-ui/bun-plugin": "^1.0.12",
    "@types/bun": "^1.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prelint": "cargo clippy -- -D warnings && cargo fmt --check && cargo check",
    "build": "bun run -F ./apps/desktop build && bun run -F ./apps/admin build",
    "lint": "bun run typecheck && oxlint",
    "lint:fix": "oxlint --fix",
    "prelint:fix": "cargo clippy --fix --allow-dirty && cargo fmt && cargo check",
    "test": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test",
    "posttest": "cargo tarpaulin --out xml --out stdout --out html --all-targets",
    "dev": "bun run desktop",
    "desktop": "bun run -F ./apps/desktop tauri dev",
    "desktop:build": "bun run -F ./apps/desktop tauri build",
    "admin": "bun run -F ./apps/admin dev",
    "prepare": "husky",
    "changepacks": "bunx @changepacks/cli",
    "summary": "bun apps/admin/scripts/summary.ts",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json"
  },
  "author": "devfive"
}
